<ui:FluentWindow x:Class="Snapshot.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Snapshot"
        Height="800" Width="1200"
        WindowStartupLocation="Manual"
        WindowBackdropType="Mica"
        ExtendsContentIntoTitleBar="True">

    <ui:FluentWindow.Resources>
        <Style x:Key="NavPillItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}"
                                Background="Transparent">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FF005FAA" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True" />
                                    <Condition Property="IsSelected" Value="False" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Snapshot" />

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Margin="12,0,4,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="16,12,16,24">
                    <TextBlock Text="Snapshot"
                               FontSize="16" FontWeight="Bold"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    <TextBlock Text="Personal backup ritual"
                               FontSize="11"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Margin="0,2,0,0" />
                </StackPanel>

                <ListBox x:Name="NavList"
                         Grid.Row="1"
                         Background="Transparent"
                         BorderThickness="0"
                         SelectionChanged="NavList_SelectionChanged">
                    <ListBoxItem Tag="Sources" IsSelected="True" Style="{StaticResource NavPillItem}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Database24" Margin="0,0,10,0" FontSize="18" />
                            <TextBlock Text="SOURCES" VerticalAlignment="Center"
                                       FontSize="11" FontWeight="Medium" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="Archives" Style="{StaticResource NavPillItem}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Archive24" Margin="0,0,10,0" FontSize="18" />
                            <TextBlock Text="ARCHIVES" VerticalAlignment="Center"
                                       FontSize="11" FontWeight="Medium" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="Sync" Style="{StaticResource NavPillItem}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="CloudSync24" Margin="0,0,10,0" FontSize="18" />
                            <TextBlock Text="SYNC" VerticalAlignment="Center"
                                       FontSize="11" FontWeight="Medium" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="Settings" Style="{StaticResource NavPillItem}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Settings24" Margin="0,0,10,0" FontSize="18" />
                            <TextBlock Text="SETTINGS" VerticalAlignment="Center"
                                       FontSize="11" FontWeight="Medium" />
                        </StackPanel>
                    </ListBoxItem>
                </ListBox>
            </Grid>

            <ContentPresenter x:Name="PageContent" Grid.Column="1" />
        </Grid>
    </Grid>
</ui:FluentWindow>
